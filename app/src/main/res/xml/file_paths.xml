<?xml version="1.0" encoding="utf-8"?>
<paths>
    <cache-path name="apk-store" path="apk-store/" />
    <!-- Снимок камеры для вложения: камера пишет сюда, приложение копирует в папку проекта. -->
    <cache-path name="camera" path="camera/" />
    <!-- «Поделиться разговором»: Markdown без секретов, отдаётся только по явному «Поделиться». -->
    <cache-path name="shared" path="shared/" />
    <!-- Резервные копии и диагностика: отдаются только через явный «Поделиться» с временным правом чтения. -->
    <files-path name="backups" path="backups/" />
    <files-path name="diagnostics" path="logs/" />
    <!-- Рабочая папка: файл отдаётся только по явному «Поделиться» в «Файлах». -->
    <external-files-path name="workspace" path="DSH-Workspace/" />
    <!-- Приватная рабочая папка без внешней памяти (StorageAccess.workspaceRoot падает на filesDir) — G-29. -->
    <files-path name="workspace-internal" path="DSH-Workspace/" />
    <external-path name="shared-workspace" path="Documents/DSH-Workspace/" />
</paths>
