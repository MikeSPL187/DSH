<?xml version="1.0" encoding="utf-8"?>
<!--
  G-37: ни облачная копия, ни перенос «телефон → телефон» (Android 12+) не забирают данные DSH.
  allowBackup="false" на Android 12+ не отключает перенос между устройствами; значения, зашифрованные ключами
  Keystore, на новом телефоне всё равно не расшифруются, а rootfs и журналы — лишние гигабайты и чужие секреты.
  Своя резервная копия — «Настройки → Резервная копия» (подписана ключом телефона).
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </device-transfer>
</data-extraction-rules>
